<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.citycourier.citycourier.viewController.administrador.ViewControllerAdmRepartidor">

    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10">
            <Label text="Gestión de Repartidores"
                   style="-fx-font-size: 18; -fx-font-weight: bold;"/>

            <HBox spacing="10">
                <TextField fx:id="txtId" promptText="ID Repartidor"/>
                <TextField fx:id="txtNombre" promptText="Nombre"/>
                <TextField fx:id="txtTelefono" promptText="Teléfono"/>
                <TextField fx:id="txtVehiculo" promptText="Vehículo asignado"/>
                <Button text="Agregar" onAction="#onAgregarRepartidor"/>
                <Button text="Eliminar" onAction="#onEliminarRepartidor"/>
            </HBox>

            <TableView fx:id="tablaRepartidores" prefHeight="400" prefWidth="700">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="100"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="150"/>
                    <TableColumn fx:id="colVehiculo" text="Vehículo" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>
