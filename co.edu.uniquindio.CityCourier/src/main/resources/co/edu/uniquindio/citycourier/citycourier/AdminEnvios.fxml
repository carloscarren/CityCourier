<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.citycourier.citycourier.viewController.administrador.ViewControllerAdmEnvios">

    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10">
            <Label text="Gestión de Envíos"
                   style="-fx-font-size: 18; -fx-font-weight: bold;"/>

            <HBox spacing="10">
                <VBox spacing="5">
                    <Label text="ID Envío:"/>
                    <TextField fx:id="txtIdEnvio" promptText="ID Envío" prefWidth="150"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Estado:"/>
                    <ComboBox fx:id="cmbEstado" prefWidth="200"/>
                </VBox>
            </HBox>

            <HBox spacing="10">
                <Button text="Actualizar Estado" onAction="#onActualizarEstado" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
                <Button text="Cancelar Envío" onAction="#onCancelarEnvio" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
                <Button text="Eliminar" onAction="#onEliminarEnvio" style="-fx-background-color: #FF5722; -fx-text-fill: white;"/>
            </HBox>

            <TableView fx:id="tablaEnvios" prefHeight="450" prefWidth="850">
                <columns>
                    <TableColumn fx:id="colId" text="Id" prefWidth="100"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
                    <TableColumn fx:id="colRepartidor" text="Repartidor" prefWidth="120"/>
                    <TableColumn fx:id="colOrigen" text="Origen" prefWidth="200"/>
                    <TableColumn fx:id="colDestino" text="Destino" prefWidth="200"/>
                    <TableColumn fx:id="colCosto" text="Costo" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>
