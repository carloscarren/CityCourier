<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- ✅ fx:controller colocado correctamente en el contenedor raíz -->
<HBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.citycourier.citycourier.viewController.loggin.ViewControllerLogin"
      prefHeight="503.0" prefWidth="854.0">

    <children>

        <!-- PANEL IZQUIERDO -->
        <VBox alignment="CENTER" prefHeight="500.0" prefWidth="427.0" HBox.hgrow="ALWAYS">
            <children>

                <!-- Título -->
                <Label text="Iniciar Sesión"
                       alignment="BOTTOM_CENTER"
                       textAlignment="CENTER"
                       prefHeight="200.0"
                       prefWidth="427.0"
                       style="-fx-font-size: 32px; -fx-font-weight: bold;" />

                <!-- Contenedor principal -->
                <VBox spacing="10" prefHeight="200.0" prefWidth="100.0">
                    <children>

                        <!-- Correo -->
                        <Label text="Correo" style="-fx-font-size: 20px;">
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </Label>
                        <TextField fx:id="txtCorreo" promptText="Ingresa tu correo" style="-fx-font-size: 18px;" />

                        <!-- Contraseña -->
                        <Label text="Contraseña" style="-fx-font-size: 20px;" />
                        <PasswordField fx:id="txtContrasena" promptText="Ingresa tu contraseña" style="-fx-font-size: 18px;" />

                        <!-- Botones -->
                        <HBox spacing="20" alignment="CENTER">
                            <padding>
                                <Insets top="30.0" />
                            </padding>
                            <children>
                                <Button fx:id="btnLogin"
                                        text="Ingresar"
                                        onAction="#onLogin"
                                        prefWidth="150"
                                        prefHeight="40"
                                        style="-fx-font-size: 18px; -fx-background-color: #11114D; -fx-text-fill: white; -fx-font-weight: bold;" />
                                <Button fx:id="btnRegistrar"
                                        text="Registrarse"
                                        onAction="#onRegistrar"
                                        prefWidth="150"
                                        prefHeight="40"
                                        style="-fx-font-size: 18px; -fx-background-color: #4444AA; -fx-text-fill: white; -fx-font-weight: bold;" />
                            </children>
                        </HBox>

                    </children>
                    <padding>
                        <Insets left="30.0" right="30.0" />
                    </padding>
                </VBox>

            </children>
        </VBox>

        <!-- PANEL DERECHO (imagen/logo) -->
        <VBox alignment="CENTER" prefHeight="200.0" prefWidth="427.0" style="-fx-background-color: #11114D;" HBox.hgrow="ALWAYS">
            <children>
            </children>
        </VBox>

    </children>
</HBox>
