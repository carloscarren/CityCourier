<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.citycourier.citycourier.viewController.administrador.ViewControllerAdmAsignarEnvio">

    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10">
            <Label text="Asignar Envíos a Repartidores"
                   style="-fx-font-size: 18; -fx-font-weight: bold;"/>

            <Label text="Seleccione un envío en estado SOLICITANDO y un repartidor disponible para realizar la asignación."
                   style="-fx-font-size: 12px; -fx-text-fill: #666;"/>

            <HBox spacing="20" alignment="CENTER_LEFT">
                <VBox spacing="5" prefWidth="400">
                    <Label text="Envíos Disponibles (SOLICITANDO)" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="cmbPedido" prefWidth="400" promptText="Seleccione un envío"/>
                </VBox>
                <VBox spacing="5" prefWidth="400">
                    <Label text="Repartidores Disponibles" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="cmbRepartidor" prefWidth="400" promptText="Seleccione un repartidor"/>
                </VBox>
            </HBox>

            <HBox spacing="10" alignment="CENTER">
                <Button text="Asignar Envío" onAction="#onAsignarEnvio" 
                        prefWidth="200" prefHeight="40"
                        style="-fx-font-size: 16px; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>

            <Separator/>

            <Label text="Asignaciones Realizadas:" style="-fx-font-weight: bold;"/>
            <TableView fx:id="tablaAsignaciones" prefHeight="250" prefWidth="800">
                <columns>
                    <TableColumn fx:id="colIdPedidoAsignacion" text="ID Envío" prefWidth="150"/>
                    <TableColumn fx:id="colRutaAsignacion" text="Repartidor Asignado" prefWidth="400"/>
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>

