<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.citycourier.citycourier.viewController.admin.AdminUsuariosController">

    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10">
            <Label text="Gestión de Usuarios" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

            <HBox spacing="10">
                <TextField fx:id="txtId" promptText="ID Usuario"/>
                <TextField fx:id="txtNombre" promptText="Nombre"/>
                <TextField fx:id="txtCorreo" promptText="Correo"/>
                <TextField fx:id="txtTelefono" promptText="Teléfono"/>
                <Button text="Agregar" onAction="#onAgregarUsuario"/>
                <Button text="Eliminar" onAction="#onEliminarUsuario"/>
            </HBox>

            <TableView fx:id="tablaUsuarios" prefHeight="400" prefWidth="700">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="100"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
                    <TableColumn fx:id="colCorreo" text="Correo" prefWidth="200"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>
