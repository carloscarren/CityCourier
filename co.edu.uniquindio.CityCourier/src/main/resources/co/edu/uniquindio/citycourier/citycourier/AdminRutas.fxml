<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.citycourier.citycourier.viewController.administrador.ViewControllerAdmRutas">

    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10">
            <Label text="Gestión de Rutas"
                   style="-fx-font-size: 18; -fx-font-weight: bold;"/>

            <HBox spacing="10">
                <VBox spacing="5">
                    <Label text="Id:"/>
                    <TextField fx:id="txtIdRuta" promptText="ID Ruta" prefWidth="150"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Ciudad Origen:"/>
                    <ComboBox fx:id="cmbCiudadOrigen" prefWidth="200"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Ciudad Destino:"/>
                    <ComboBox fx:id="cmbCiudadDestino" prefWidth="200"/>
                </VBox>
                <VBox spacing="5">
                    <Label text="Distancia:"/>
                    <TextField fx:id="txtDistancia" promptText="Distancia (km)" prefWidth="150"/>
                </VBox>
            </HBox>

            <HBox spacing="10">
                <Button text="Registrar" onAction="#onRegistrarRuta" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                <Button text="Actualizar" onAction="#onActualizarRuta" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
                <Button text="Eliminar" onAction="#onEliminarRuta" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
            </HBox>

            <TableView fx:id="tablaRutas" prefHeight="450" prefWidth="750">
                <columns>
                    <TableColumn fx:id="colIdRuta" text="ID" prefWidth="100"/>
                    <TableColumn fx:id="colOrigen" text="Origen" prefWidth="200"/>
                    <TableColumn fx:id="colDestino" text="Destino" prefWidth="200"/>
                    <TableColumn fx:id="colDistancia" text="Distancia (km)" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>

